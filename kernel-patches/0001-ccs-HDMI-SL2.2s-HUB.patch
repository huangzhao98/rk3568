Subject: [PATCH 1/5] =?UTF-8?q?ccs:=20HDMI=20=E6=9C=AC=E5=9C=B0=E6=8E=A7?=
 =?UTF-8?q?=E5=88=B6=E5=8F=B0=20+=20SL2.2s=20HUB=20=E4=BE=9B=E7=94=B5?=
 =?UTF-8?q?=E8=AF=86=E5=88=AB=E4=BF=AE=E5=A4=8D?=
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

- defconfig: 打开 FRAMEBUFFER_CONSOLE/FONT_8x8/FONT_8x16/LOGO，HDMI 屏出 tty1 登录终端
- hub.c: 自供电判定补认配置描述符 bmAttributes SELFPOWER——SL2.2s(1a40:0101)
  GET_STATUS 不回报 self-powered，否则每口限 100mA，500mA 设备（游戏键盘）被拒配置
---
 arch/arm64/configs/rockchip_linux_defconfig |  6 ++++++
 drivers/usb/core/hub.c                      | 11 ++++++++++-
 2 files changed, 16 insertions(+), 1 deletion(-)

diff --git a/arch/arm64/configs/rockchip_linux_defconfig b/arch/arm64/configs/rockchip_linux_defconfig
index b7b29d7ed..cff6c0ec9 100644
--- a/arch/arm64/configs/rockchip_linux_defconfig
+++ b/arch/arm64/configs/rockchip_linux_defconfig
@@ -630,3 +630,9 @@ CONFIG_USB_CONFIGFS_F_HID=y
 CONFIG_USB_F_HID=y
 # 备用：硬件 I2C 不够时 bit-bang
 CONFIG_I2C_GPIO=m
+# HDMI 本地显示控制台（fbcon → DRM fbdev，HDMI 屏显示 tty1 登录终端）
+# VT/DRM_FBDEV_EMULATION/USB_HID 依赖 Kconfig 默认 y，此处只需显式打开 fbcon 与字体
+CONFIG_FRAMEBUFFER_CONSOLE=y
+CONFIG_FONT_8x8=y
+CONFIG_FONT_8x16=y
+CONFIG_LOGO=y
diff --git a/drivers/usb/core/hub.c b/drivers/usb/core/hub.c
index 581bd13a0..8c8655101 100644
--- a/drivers/usb/core/hub.c
+++ b/drivers/usb/core/hub.c
@@ -1558,7 +1558,16 @@ static int hub_configure(struct usb_hub *hub,
 			hub->mA_per_port = hdev->bus_mA;
 			hub->limited_power = 1;
 		}
-	} else if ((hubstatus & (1 << USB_DEVICE_SELF_POWERED)) == 0) {
+	/*
+	 * CCS: SL2.2s (1a40:0101) 的 GET_STATUS 不回报 self-powered，
+	 * 但其配置描述符 bmAttributes 声称自供电——两者都认可为自供电，
+	 * 否则外接 HUB 每口预算被限成 100mA，500mA 设备（如游戏键盘）
+	 * 会被 "insufficient available bus power" 拒绝配置。
+	 * 风险与 generic.c 注释一致：高估预算属良性（板载 VBUS 常开）。
+	 */
+	} else if ((hubstatus & (1 << USB_DEVICE_SELF_POWERED)) == 0 &&
+		   !(hdev->config[0].desc.bmAttributes &
+		     USB_CONFIG_ATT_SELFPOWER)) {
 		int remaining = hdev->bus_mA -
 			hub->descriptor->bHubContrCurrent;
 
-- 
