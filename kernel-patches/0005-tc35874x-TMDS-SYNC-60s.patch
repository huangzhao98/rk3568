误触PHY_RST等异常后SYNC永久丢失,i2c正常时原有自救不触发,
HPD重锁也救不回,只能整机重启。work_unmute增加nosync计时,
60s不自愈则打复位脚重建寄存器(不unbind,媒体链路保持)。
---
 drivers/media/i2c/tc35874x.c | 17 +++++++++++++++++
 1 file changed, 17 insertions(+)

diff --git a/drivers/media/i2c/tc35874x.c b/drivers/media/i2c/tc35874x.c
index 96d5634ef..c60f6f912 100644
--- a/drivers/media/i2c/tc35874x.c
+++ b/drivers/media/i2c/tc35874x.c
@@ -206,6 +206,7 @@ struct tc35874x_state {
 	 * 把 CSI TX 帧相位钉回常数（见 enable_stream 注释） */
 	struct delayed_work work_unmute;
 	unsigned long lock_since;	/* 连续锁定的起始时刻，0=未锁定 */
+	unsigned long nosync_since;	/* TMDS 在而 SYNC 丢失的起始时刻，0=正常 */
 	unsigned int i2c_errs;		/* 连续 i2c 读失败计数（挂死自救用） */
 	bool stream_on;			/* 应用层已请求开流 */
 
@@ -723,6 +724,7 @@ static void tc35874x_self_reset(struct tc35874x_state *state)
 		tc35874x_enable_interrupts(sd, false);
 	i2c_wr8(sd, VI_MUTE, MASK_AUTO_MUTE | MASK_VI_MUTE);
 	state->lock_since = 0;
+	state->nosync_since = 0;
 	state->i2c_errs = 0;
 }
 
@@ -757,9 +759,24 @@ static void tc35874x_work_unmute(struct work_struct *work)
 			v4l2_info(sd, "ccs: sync lost, force mute\n");
 		i2c_wr8(sd, VI_MUTE, MASK_AUTO_MUTE | MASK_VI_MUTE);
 		state->lock_since = 0;
+		/* TMDS 在而 SYNC 超过 60s 不回来 = 芯片同步通路卡死（PHY 层
+		 * 异常等，2026-10-27 实测：误触 PHY_RST 后 SYNC 永久丢失，
+		 * HPD 重锁也救不回），保持现状永远无帧，自救复位重建 */
+		if ((sys & MASK_S_TMDS) && !(sys & MASK_S_SYNC)) {
+			if (!state->nosync_since)
+				state->nosync_since = jiffies;
+			else if (time_after(jiffies,
+					    state->nosync_since + 60 * HZ)) {
+				v4l2_info(sd, "ccs: sync wedged 60s, self reset\n");
+				tc35874x_self_reset(state);
+			}
+		} else {
+			state->nosync_since = 0;
+		}
 		schedule_delayed_work(&state->work_unmute, HZ);
 		return;
 	}
+	state->nosync_since = 0;
 	if (!state->lock_since)
 		state->lock_since = jiffies;
 	if (time_before(jiffies, state->lock_since + 4 * HZ)) {
