tc35874x: 4-lane else分支fifo_level由1500(被10bit字段截成476)改为
clamp_val(width/2-30, 100, 476)。阈值≥一行FIFO字数(width/2)时TX
在一行内攒不到启动水位，看不到消隐行间隙，帧边界失同步自跑，
画面匀速卷动(800x800实测~68行/秒,FS节奏59.82fps vs 输入~59.90)。
720p/1080p显式370分支与VGA欠载修复(476上限)不受影响。

rkcif capture.c: extra FS事件记录tau_ns与近期帧间隔ring(1.024us
单位)便于诊断; multi-fs容错分支吸收偶发多余FS, 实测事件前后
帧内容shift=0不再卷动。
---
 drivers/media/i2c/tc35874x.c                  | 18 ++++---
 drivers/media/platform/rockchip/cif/capture.c | 50 +++++++++++++++++--
 2 files changed, 57 insertions(+), 11 deletions(-)

diff --git a/drivers/media/i2c/tc35874x.c b/drivers/media/i2c/tc35874x.c
index 78b8cd0d9..18ab715a3 100644
--- a/drivers/media/i2c/tc35874x.c
+++ b/drivers/media/i2c/tc35874x.c
@@ -536,12 +536,18 @@ static int tc35874x_get_detected_timings(struct v4l2_subdev *sd,
 			(width == 720 && height == 480)) {
 			fifo_level = 350;
 		} else {
-			/* CCS: 300 在 4-lane 594Mbps 下对低像素时钟源（如 VGA
-			 * 1024x768@60 pclk=65MHz，填充速率仅为排空速率的 ~44%）
-			 * 会 FIFO 欠载，CSI 插零（画面绿色虚线条纹）。
-			 * 实测 500/1000/1500/2000 干净，2500 超 FIFO 容量（2048）
-			 * 直接崩坏；取 1500 留足余量。 */
-			fifo_level = 1500;
+			/* CCS 2026-10-31：FIFOCTL 阈值必须小于一行占用的
+			 * FIFO 字数（UYVY：width*2 字节/行 ÷ 4 字节/字
+			 * = width/2 字）。阈值 ≥ 一行字数时，TX 在一行内
+			 * 永远攒不到启动水位，只能等 FIFO 堆过一整行才发车，
+			 * 从此看不到消隐期的行间隙，帧边界失去输入同步
+			 * 自跑——画面匀速连续卷动（800x800 实测 ~68 行/秒）。
+			 * 注意 FIFOCTL 是 10bit 字段，写 >1023 会被截断
+			 * （旧值 1500 实际生效 476，恰好压垮 400 字/行的
+			 * 800 宽时序；476 < 680 字/行的 1360x768 等不受影响）。
+			 * 故按行字数减 30 字余量封顶，上限保留 VGA 链验证过
+			 * 的 476，下限 100 防止欠载插零（绿虚线）。 */
+			fifo_level = clamp_val(width / 2 - 30, 100, 476);
 		}
 
 		if ((bt->interlaced == V4L2_DV_INTERLACED) || (fps <= 33))
diff --git a/drivers/media/platform/rockchip/cif/capture.c b/drivers/media/platform/rockchip/cif/capture.c
index cb1caae62..abdab9d8b 100644
--- a/drivers/media/platform/rockchip/cif/capture.c
+++ b/drivers/media/platform/rockchip/cif/capture.c
@@ -6007,6 +6007,36 @@ void rkcif_set_default_fmt(struct rkcif_device *cif_dev)
 	}
 }
 
+/* CCS: 逐帧 FS 间隔环形记录（诊断帧节奏漂移：800x800@60 等非标时序下
+ * 芯片 TX 帧节奏与输入场不同步，画面连续缓慢卷动）。平时仅一次减法+
+ * 数组写，判定帧内多发 FS 时才转储，开销可忽略。单位 ~1us（ns>>10）。 */
+static u32 ccs_fs_ring[16];
+static u8 ccs_fs_ri;
+
+static void ccs_fs_track(struct rkcif_device *cif_dev,
+			 struct rkcif_stream *detect_stream,
+			 u32 lastline)
+{
+	u64 now = ktime_get_ns();
+	u64 prev = detect_stream->readout.fs_timestamp;
+
+	detect_stream->readout.fs_timestamp = now;
+	if (!prev)
+		return;
+	ccs_fs_ring[ccs_fs_ri++ & 0xf] = (u32)((now - prev) >> 10);
+	if (detect_stream->fs_cnt_in_single_frame > 1) {
+		char buf[128];
+		int i, n = 0;
+
+		for (i = 0; i < 16; i++)
+			n += scnprintf(buf + n, sizeof(buf) - n, "%u ",
+				       ccs_fs_ring[(ccs_fs_ri + i) & 0xf]);
+		v4l2_info(&cif_dev->v4l2_dev,
+			  "ccs: extra FS tau_ns=%llu lastline=%u ring_us: %s\n",
+			  now - prev, lastline & 0x3fff, buf);
+	}
+}
+
 void rkcif_irq_pingpong(struct rkcif_device *cif_dev)
 {
 	struct rkcif_stream *stream;
@@ -6070,7 +6100,7 @@ void rkcif_irq_pingpong(struct rkcif_device *cif_dev)
 				rkcif_lvds_event_inc_sof(cif_dev);
 			detect_stream->fs_cnt_in_single_frame++;
 			spin_lock_irqsave(&detect_stream->fps_lock, flags);
-			detect_stream->readout.fs_timestamp = ktime_get_ns();
+			ccs_fs_track(cif_dev, detect_stream, lastline);
 			spin_unlock_irqrestore(&detect_stream->fps_lock, flags);
 		}
 
@@ -6081,7 +6111,7 @@ void rkcif_irq_pingpong(struct rkcif_device *cif_dev)
 				rkcif_lvds_event_inc_sof(cif_dev);
 			detect_stream->fs_cnt_in_single_frame++;
 			spin_lock_irqsave(&detect_stream->fps_lock, flags);
-			detect_stream->readout.fs_timestamp = ktime_get_ns();
+			ccs_fs_track(cif_dev, detect_stream, lastline);
 			spin_unlock_irqrestore(&detect_stream->fps_lock, flags);
 		}
 		for (i = 0; i < RKCIF_MAX_STREAM_MIPI; i++) {
@@ -6148,12 +6178,22 @@ void rkcif_irq_pingpong(struct rkcif_device *cif_dev)
 			if (mipi_id == RKCIF_STREAM_MIPI_ID0) {
 				if ((intstat & (CSI_FRAME1_START_ID0 | CSI_FRAME0_START_ID0)) == 0 &&
 				    detect_stream->fs_cnt_in_single_frame > 1) {
-					v4l2_err(&cif_dev->v4l2_dev,
-						 "%s ERR: multi fs in oneframe, bak_int:0x%x, fs_num:%u\n",
+					/* CCS: 帧内多 FS（TC358743 在部分时序下周期性多发
+					 * 帧头标记，数据本身连续）只记录、不置
+					 * is_fs_fe_not_paired——否则监控判"fs/fe 不配对"
+					 * 触发 reset-in-streaming，DMA 在多发的 FS 处
+					 * （帧中间）重新布防，画面相位每次跳变且累积，
+					 * 表现为周期性卷动（2026-10-31 实捕：800x800@60
+					 * pclk=47.4MHz 每 ~13.4s 一次 multi fs，每次跳
+					 * ~百行；800x500@60 pclk=29.7MHz 每 8.38s 一次）。
+					 * 帧数据连续性不受多发 FS 影响，FE 照常收尾，
+					 * 下一帧仍从真 FS 开始。真正的断帧（FE 不到）
+					 * 仍由 fs_cnt_in_single_frame > N 分支兜底复位。 */
+					v4l2_info(&cif_dev->v4l2_dev,
+						 "%s: multi fs in oneframe (tolerated), bak_int:0x%x, fs_num:%u\n",
 						 __func__,
 						 bak_intstat,
 						 detect_stream->fs_cnt_in_single_frame);
-					detect_stream->is_fs_fe_not_paired = true;
 					detect_stream->fs_cnt_in_single_frame = 0;
 				} else {
 					detect_stream->fs_cnt_in_single_frame--;
-- 
